{
  "name": "react-hook-form-mantine",
  "version": "4.1.0",
  "description": "React hook form wrapper for Mantine components",
  "keywords": [
    "form-validation",
    "mantine",
    "react-hook-form"
  ],
  "homepage": "https://aranlucas.github.io/react-hook-form-mantine",
  "license": "MIT",
  "author": "Lucas Arango",
  "repository": {
    "type": "git",
    "url": "https://github.com/aranlucas/react-hook-form-mantine.git"
  },
  "source": "src/index.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build",
    "build-storybook": "storybook build",
    "coverage": "vitest run --coverage",
    "format": "oxfmt --check --config oxfmt.config.ts",
    "format:fix": "oxfmt --write --config oxfmt.config.ts",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "prepare": "husky",
    "prepublishOnly": "pnpm build",
    "semantic-release": "semantic-release",
    "storybook": "portless run storybook dev",
    "test": "vitest run",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit && pnpm --dir example typecheck",
    "test:unit": "vitest --project=unit",
    "test:storybook": "vitest --project=storybook",
    "format:check": "oxfmt --check --config oxfmt.config.ts"
  },
  "dependencies": {
    "merge-refs": "^2.0.0"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "^0.2.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@hookform/resolvers": "^6.0.0",
    "@mantine/core": "^9.7.3",
    "@mantine/dates": "^9.7.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-mcp": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright": "^1.64.1",
    "portless": "0.15.8",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "semantic-release": "^25.0.9",
    "storybook": "^10.6.3",
    "typescript": "^7.0.2",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@mantine/core": "^9.0.0",
    "@mantine/dates": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.43"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix --deny-warnings",
      "oxfmt --write --config oxfmt.config.ts --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yml,yaml,html,toml,vue,svelte,astro,graphql}": [
      "oxfmt --write --config oxfmt.config.ts --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.14.0",
  "pnpm": {
    "shamefullyHoist": true,
    "strictPeerDependencies": false
  },
  "isLibrary": true
}
