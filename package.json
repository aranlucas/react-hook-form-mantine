{
  "name": "react-hook-form-mantine",
  "version": "4.1.0",
  "description": "React hook form wrapper for Mantine components",
  "keywords": [
    "form-validation",
    "mantine",
    "react-hook-form"
  ],
  "homepage": "https://aranlucas.github.io/react-hook-form-mantine",
  "license": "MIT",
  "author": "Lucas Arango",
  "repository": {
    "type": "git",
    "url": "https://github.com/aranlucas/react-hook-form-mantine.git"
  },
  "source": "src/index.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "storybook:portless": "portless run --name storybook.react-hook-form-mantine storybook dev --host 127.0.0.1 --exact-port --no-open",
    "dev:example:portless": "pnpm --dir example dev:portless",
    "build": "vite build",
    "build-storybook": "storybook build",
    "commitlint": "node scripts/commitlint.mjs",
    "coverage": "vitest run --coverage",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "prepare": "husky",
    "prepublishOnly": "pnpm build",
    "semantic-release": "semantic-release",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit && pnpm --dir example typecheck && tsc --project tsconfig.anti-slop.json",
    "test:unit": "vitest --project=unit",
    "test:storybook": "vitest --project=storybook"
  },
  "dependencies": {
    "merge-refs": "^2.0.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/format": "^21.2.3",
    "@commitlint/lint": "^21.2.3",
    "@commitlint/load": "^21.2.3",
    "@hookform/resolvers": "^5.9.1",
    "@mantine/core": "^9.7.1",
    "@mantine/dates": "^9.7.1",
    "@oxlint/plugins": "1.87.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-mcp": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.72.0",
    "oxlint": "1.87.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "semantic-release": "^25.0.9",
    "storybook": "^10.6.1",
    "typescript": "^7.0.2",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@mantine/core": "^9.0.0",
    "@mantine/dates": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.43"
  },
  "packageManager": "pnpm@12.10.1",
  "pnpm": {
    "shamefullyHoist": true,
    "strictPeerDependencies": false
  },
  "isLibrary": true
}
