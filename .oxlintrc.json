{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@aranlucas/oxforge/configs/recommended.json",
    "./node_modules/@aranlucas/oxforge/configs/react.json",
    "./node_modules/@aranlucas/oxforge/configs/vitest.json",
    "./node_modules/@aranlucas/oxforge/configs/type-aware.json"
  ],
  "rules": {
    "oxc/no-accumulating-spread": "error",
    "unicorn/filename-case": [
      "error",
      {
        "cases": {
          "kebabCase": true,
          "pascalCase": true,
          "camelCase": true
        }
      }
    ],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": [
          "**/*.css",
          "**/env",
          "@testing-library/jest-dom/vitest",
          "@semantic-release/changelog",
          "@semantic-release/git",
          "./form-addon/manager"
        ]
      }
    ],
    "eslint/no-console": [
      "error",
      {
        "allow": ["error", "log"]
      }
    ]
  },
  "ignorePatterns": [
    "example",
    "dist",
    "storybook-static",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/.expo/**",
    "**/.vercel/**",
    "**/.agent/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.codex/**",
    "**/.continue/**",
    "**/.cursor/**",
    "**/.gemini/**",
    "**/.opencode/**",
    "**/.pi/**",
    "**/.roo/**",
    "**/.windsurf/**"
  ],
  "options": {
    "typeAware": true
  },
  "overrides": [
    {
      "files": [
        "src/test/test-utils.tsx",
        ".storybook/preview.tsx",
        ".storybook/form-addon/manager.tsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": [".storybook/preview.tsx"],
      "rules": {
        "anti-slop/no-unsafe-dictionary-type": "off"
      }
    }
  ]
}
